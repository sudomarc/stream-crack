# StreamCrack workflow configuration
#
# Copy this file to `.claude/.env` and fill in the real values.
# NEVER commit `.claude/.env` -- it holds secrets. See .gitignore.
#
# These values feed the authorized GitHub integrations that build, sign, and
# publish StreamCrack releases, the signed APT repository, and the official
# mini-site on GitHub Pages.

# GitHub repository (owner/repo) that hosts StreamCrack.
STREAMCRACK_REPO=sudomarc/stream-crack

# ASCII-armored GPG private key used to sign the APT repository (Release/InRelease).
# Provided to GitHub Actions as the STREAMCRACK_GPG_PRIVATE_KEY secret.
STREAMCRACK_GPG_PRIVATE_KEY=

# Passphrase protecting the GPG private key (set only if the key has one).
# Provided to GitHub Actions as the STREAMCRACK_GPG_PASSPHRASE secret.
STREAMCRACK_GPG_PASSPHRASE=

# GitHub token with `repo` and `contents: write` scope, used to create releases,
# upload release assets (.deb), commit APT repository updates, and publish pages.
# Provided to GitHub Actions as the STREAMCRACK_GITHUB_TOKEN secret.
STREAMCRACK_GITHUB_TOKEN=

# APT repository metadata.
STREAMCRACK_APT_DIST=stable
STREAMCRACK_APT_COMPONENT=main
STREAMCRACK_APT_ARCH=amd64

# GPG key identity used for signing (must match the generated key).
STREAMCRACK_GPG_NAME="StreamCrack"
STREAMCRACK_GPG_EMAIL="release@streamcrack.example.org"
